{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/decision.js": {
      "includeFiles": "artifacts/hosted/{v3.bin.gz,train_v5}",
      "maxDuration": 60
    },
    "api/arena.js": {
      "includeFiles": "artifacts/hosted/{v3.bin.gz,v2.bin,v1.policy,arena}",
      "maxDuration": 300
    }
  }
}
